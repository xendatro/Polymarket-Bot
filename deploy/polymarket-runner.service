[Unit]
Description=Polymarket agent runner (scheduler, polling, settlements)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=__REPO__/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__REPO__/.venv/bin/python -m runner
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=0
KillSignal=SIGTERM
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
